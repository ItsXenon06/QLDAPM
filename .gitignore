# GitHub source allowlist. Everything else stays local by default.
/*
!/.gitignore
!/.gitattributes
!/pom.xml
!/mvnw
!/mvnw.cmd
!/.env.example

# Maven wrapper configuration (downloaded binaries stay local).
!/.mvn/
/.mvn/*
!/.mvn/wrapper/
/.mvn/wrapper/*
!/.mvn/wrapper/maven-wrapper.properties

# Production backend, configuration and frontend.
!/src/
/src/*
!/src/main/
!/src/main/**

# Reproducible empty database schema, without sample data or personal guides.
!/database/
/database/*
!/database/001_initial_schema.sql

# Defense in depth inside the allowed source tree.
**/.env
**/.env.*
**/application-local.properties
**/application-local.yml
**/application-local.yaml
**/application-secrets.properties
**/application-secrets.yml
**/application-secrets.yaml
**/credentials.json
**/service-account*.json
**/.aws/
**/.ssh/
**/.codex/
**/.agents/
**/id_rsa
**/id_ed25519
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore

# Local notes, reports, test material and data exports.
*.md
*.doc
*.docx
*.pdf
*.xls
*.xlsx
*.csv
*.tsv
*.bak
*.backup
*.dump
*.sql
*.zip
*.7z
*.rar
*.log
*.tmp
*.swp
*.swo
*~
**/src/test/
**/*Test.java
**/*Tests.java
**/node_modules/
**/target/
**/.idea/
**/.vscode/
**/.DS_Store
**/Thumbs.db
**/Desktop.ini

# This public template contains placeholders, never live credentials.
!/.env.example
!/database/001_initial_schema.sql

# Required production migration bundled in the application.
!/src/main/resources/db/sepay.sql

# Public clone/demo instructions and sanitized reproducible demo setup.
!/README.md
!/database/002_demo_seed.sql
!/scripts/
/scripts/*
!/scripts/Create-Demo-Database.ps1
!/scripts/Start-App.ps1
!/scripts/Start-SePay-Tunnel.ps1
!/scripts/Stop-SePay-Tunnel.ps1
!/scripts/sepay-webhook-proxy.py
